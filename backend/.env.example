# Server Configuration
PORT=4000
NODE_ENV=production
FRONTEND_ORIGIN=https://your-frontend-url.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secret (Generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-here

# Default Admin Account
ADMIN_DEFAULT_ROLE=super_admin
ADMIN_DEFAULT_USERNAME=superadmin
ADMIN_DEFAULT_PASSWORD=your-secure-password-hash

# Store Configuration (Rembang coordinates)
STORE_LAT=-6.727475111
STORE_LNG=111.331513
MAX_FREE_DELIVERY_KM=3

# File Upload
MAX_FILE_SIZE=5242880
